{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "github>konflux-ci/mintmaker//config/renovate/renovate.json"
    ],
    "tekton": {
      "includePaths": [
        "pipelines/**",
        "tasks/**",
        "stepactions/**"
      ]
    },
    "packageRules": [
      {
        "description": "Ignore RHTAS product images that are pinned to specific release versions",
        "matchDatasources": ["docker"],
        "enabled": false,
        "matchPackageNames": [
          "/^registry\\.redhat\\.io/rhtas//"
        ]
      }
    ],
    "customManagers": [
      {
        "customType": "regex",
        "description": "Update container image references in Tekton parameter defaults",
        "managerFilePatterns": [
          "/pipelines/.+\\.yaml$/",
          "/tasks/.+\\.yaml$/",
          "/stepactions/.+\\.yaml$/"
        ],
        "matchStrings": [
          "default:\\s*(?<depName>[a-z0-9.\\-]+\\/[^@:\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
          "default:\\s*(?<depName>[a-z0-9.\\-]+\\/[^@:\\s]+):(?<currentValue>[a-z0-9.\\-]+)"
        ],
        "datasourceTemplate": "docker"
      }
    ]
  }
